---
import { LightbulbProbe } from '@workbench/instruments';

const { toc, slug } = Astro.locals.starlightRoute;
const isChapter = slug?.startsWith('chapters/');
const showInstruments = isChapter && slug !== 'chapters/01-introduction';
---

{showInstruments ? (
  <div class="workbench-split" id="workbench-split">
    <div class="split-content" id="split-content">
      <div class="split-content-inner"><slot /></div>
    </div>
    <div class="split-handle" id="split-handle" role="separator" aria-label="Resize panels" tabindex="0"></div>
    <div class="split-instruments" id="split-instruments">
      <div class="split-instruments-inner">
        <div class="instrument-block">
          <div class="instrument-label">Unleash Admin</div>
          <iframe
            src="/unleash/"
            class="instruments-unleash"
            title="Unleash Admin UI"
            loading="lazy"
          ></iframe>
        </div>
        <div class="instrument-block">
          <div class="instrument-label">Flag Probe</div>
          <LightbulbProbe client:visible />
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="lg:sl-flex">
    <div class="main-pane"><slot /></div>
  </div>
)}

<script is:inline>
(function() {
  var split = document.getElementById('workbench-split');
  var handle = document.getElementById('split-handle');
  var content = document.getElementById('split-content');
  if (!split || !handle || !content) return;

  var STORAGE_KEY = 'workbench:split-pct';
  var MIN_CONTENT_PCT = 20;
  var MIN_INSTRUMENTS_PCT = 30;
  var dragging = false;

  // Restore saved position
  var saved = parseFloat(sessionStorage.getItem(STORAGE_KEY));
  if (saved && saved >= MIN_CONTENT_PCT && saved <= 100 - MIN_INSTRUMENTS_PCT) {
    content.style.flexBasis = saved + '%';
  }

  function setPct(pct) {
    pct = Math.max(MIN_CONTENT_PCT, Math.min(100 - MIN_INSTRUMENTS_PCT, pct));
    content.style.flexBasis = pct + '%';
    sessionStorage.setItem(STORAGE_KEY, pct.toFixed(1));
  }

  handle.addEventListener('pointerdown', function(e) {
    dragging = true;
    handle.classList.add('active');
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';
    split.classList.add('dragging');
    e.preventDefault();
  });

  document.addEventListener('pointermove', function(e) {
    if (!dragging) return;
    var rect = split.getBoundingClientRect();
    var pct = ((e.clientX - rect.left) / rect.width) * 100;
    setPct(pct);
  });

  document.addEventListener('pointerup', function() {
    if (!dragging) return;
    dragging = false;
    handle.classList.remove('active');
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
    split.classList.remove('dragging');
  });

  handle.addEventListener('keydown', function(e) {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    var rect = split.getBoundingClientRect();
    var step = rect.width * 0.02;
    var delta = e.key === 'ArrowLeft' ? -step : step;
    var newPct = ((content.getBoundingClientRect().width + delta) / rect.width) * 100;
    setPct(newPct);
    e.preventDefault();
  });
})();
</script>

<style>
  .main-pane {
    isolation: isolate;
    width: 100%;
  }

  /* Split layout — fills the viewport below the nav */
  .workbench-split {
    display: flex;
    height: calc(100vh - var(--sl-nav-height));
    overflow: hidden;
  }

  /* Content: scrollable center column */
  .split-content {
    flex: 0 0 calc(100% - 1024px);
    min-width: 20%;
    overflow: hidden;
  }

  .split-content-inner {
    height: 100%;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  /* Draggable splitter — full height, visible on hover */
  .split-handle {
    flex: 0 0 6px;
    cursor: col-resize;
    background: transparent;
    transition: background 0.15s;
    touch-action: none;
    position: relative;
    z-index: 10;
  }

  .split-handle:hover {
    background: var(--color-accent, #6C65E5);
  }

  .split-handle.active {
    background: var(--color-accent-hover, #5B54D4);
  }

  /* Instruments: right panel, independently scrollable */
  .split-instruments {
    flex: 1 1 auto;
    min-width: 30%;
    overflow: hidden;
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  .split-instruments-inner {
    height: 100%;
    overflow-y: auto;
    scrollbar-width: thin;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Prevent iframe from stealing events while dragging */
  .workbench-split.dragging .instruments-unleash {
    pointer-events: none;
  }

  .instrument-block {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .instrument-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
    padding-left: 0.25rem;
  }

  .instruments-unleash {
    width: 100%;
    flex: 1 1 auto;
    min-height: 400px;
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 8px;
    background: white;
  }

  /* Responsive: stack on smaller screens */
  @media (max-width: 72rem) {
    .workbench-split {
      flex-direction: column;
      height: auto;
      overflow: visible;
    }

    .split-content {
      flex-basis: auto !important;
      min-width: 0;
      overflow: visible;
    }

    .split-content-inner {
      height: auto;
      overflow: visible;
    }

    .split-handle {
      display: none;
    }

    .split-instruments {
      min-width: 0;
      border-inline-start: none;
      border-top: 1px solid var(--sl-color-hairline);
    }

    .split-instruments-inner {
      height: auto;
    }
  }
</style>
