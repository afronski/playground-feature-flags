# ── Unleash (hosted Enterprise) ──────────────────────────────────────────────
# Instance URL, everything before /api, e.g. https://us.app.unleash-hosted.com/abcd1234
UNLEASH_URL=
# Personal Access Token (Profile → Personal API tokens) of an Admin. Used by the scripts and by
# the demo UI (live rules, Playground verdicts, change requests). Never by the app itself.
# ⚠ An Admin PAT in a running web process is NOT recommended: this is for demos only.
UNLEASH_PAT=
# Project the scripts create and the app reads. Default: experiments-demo
UNLEASH_PROJECT_ID=experiments-demo

# ── Four-eyes approver (second Unleash user, created by `npm run provision`) ──
# Required, no default. Creating a user may use a paid seat.
UNLEASH_APPROVER_EMAIL=
UNLEASH_APPROVER_NAME=Demo Approver
# Needed only when the user is first created. Must meet your instance's password rules.
UNLEASH_APPROVER_PASSWORD=

# ── Backend SDK tokens: written by `npm run provision`, leave empty ──────────
UNLEASH_API_TOKEN_DEVELOPMENT=
UNLEASH_API_TOKEN_PRODUCTION=

# ── App, demo UI and sink ────────────────────────────────────────────────────
# The app holds the back-end SDK tokens only. The demo UI (the grid page) holds UNLEASH_PAT.
APP_PORT=3000
APP_URL=http://localhost:3000
APP_NAME=experiments-demo-app
DEMO_UI_PORT=3002
DEMO_UI_URL=http://localhost:3002
SINK_PORT=3001
SINK_URL=http://localhost:3001

# ── BigQuery (optional: leave empty to keep events in data/impressions.jsonl only) ──
# Auth: `gcloud auth application-default login`, or a service-account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=unleash
BIGQUERY_TABLE=impressions
BIGQUERY_LOCATION=US
